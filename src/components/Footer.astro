---
const year = new Date().getFullYear();
---

<footer class="bg-cancha-900 text-cancha-200 mt-16">
  <div class="max-w-6xl mx-auto px-4 py-10 grid gap-8 md:grid-cols-3">
    <div>
      <p class="font-display font-bold text-white text-lg mb-2">Selección Loncoche TDM</p>
      <p class="text-sm text-cancha-300">
        Noticiero oficial de la Selección de Tenis de Mesa de la comuna de Loncoche, Región de La Araucanía.
      </p>
    </div>
    <div>
      <p class="font-semibold text-white mb-2">Navegación</p>
      <ul class="space-y-1 text-sm">
        <li><a href="/noticias" class="hover:text-white">Noticias</a></li>
        <li><a href="/equipo" class="hover:text-white">Equipo</a></li>
        <li><a href="/calendario" class="hover:text-white">Calendario</a></li>
        <li><a href="/contacto" class="hover:text-white">Contacto</a></li>
      </ul>
    </div>
    <div>
      <p class="font-semibold text-white mb-2">Contacto</p>
      <ul class="space-y-1 text-sm text-cancha-300">
        <li>Gimnasio Municipal de Loncoche</li>
        <li>seleccion.tdm.loncoche@example.com</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-cancha-700 py-4 text-center text-xs text-cancha-400">
    © {year} Selección de Tenis de Mesa de Loncoche. Sitio informativo no oficial.
  </div>
</footer>
