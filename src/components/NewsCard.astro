---
import type { CollectionEntry } from 'astro:content';

interface Props {
  noticia: CollectionEntry<'noticias'>;
  destacada?: boolean;
}

const { noticia, destacada = false } = Astro.props;
const { titulo, resumen, fecha, categoria, imagen } = noticia.data;

const fechaFormateada = fecha.toLocaleDateString('es-CL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const categoriaColor: Record<string, string> = {
  Resultados: 'bg-pelota-500 text-cancha-900',
  Convocatorias: 'bg-cancha-500 text-white',
  Torneos: 'bg-cancha-700 text-white',
  Institucional: 'bg-slate-500 text-white',
};
---

<a
  href={`/noticias/${noticia.slug}`}
  class:list={[
    'group block rounded-2xl bg-white dark:bg-cancha-900 shadow-sm border border-slate-200 dark:border-cancha-700 overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all',
    destacada ? 'md:col-span-2' : '',
  ]}
>
  {imagen && (
    <div class="relative overflow-hidden">
      <img
        src={imagen}
        alt={titulo}
        class:list={[
          'w-full object-cover object-top saturate-[1.08] contrast-[1.03] group-hover:scale-105 transition-transform duration-500',
          destacada ? 'h-56 md:h-72' : 'h-40',
        ]}
      />
      <div class="absolute inset-0 bg-cancha-900/10 mix-blend-multiply" />
    </div>
  )}
  <div class:list={['p-6', destacada ? 'md:p-8' : '']}>
    <div class="flex items-center gap-3 mb-3">
      <span class:list={['text-xs font-semibold px-3 py-1 rounded-full', categoriaColor[categoria]]}>
        {categoria}
      </span>
      <time class="text-xs text-slate-500 dark:text-slate-400">{fechaFormateada}</time>
    </div>
    <h3 class:list={['font-display font-bold text-cancha-900 dark:text-white group-hover:text-cancha-600 dark:group-hover:text-pelota-400 transition-colors', destacada ? 'text-2xl md:text-3xl mb-3' : 'text-lg mb-2']}>
      {titulo}
    </h3>
    <p class:list={['text-slate-600 dark:text-slate-300', destacada ? 'text-base' : 'text-sm']}>{resumen}</p>
    <span class="inline-block mt-4 text-sm font-semibold text-cancha-600 dark:text-pelota-400 group-hover:translate-x-1 transition-transform">
      Leer más →
    </span>
  </div>
</a>
