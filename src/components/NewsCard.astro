---
import type { CollectionEntry } from 'astro:content';

interface Props {
  noticia: CollectionEntry<'noticias'>;
  destacada?: boolean;
}

const { noticia, destacada = false } = Astro.props;
const { titulo, resumen, fecha, categoria } = noticia.data;

const fechaFormateada = fecha.toLocaleDateString('es-CL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const categoriaColor: Record<string, string> = {
  Resultados: 'bg-pelota-500 text-cancha-900',
  Convocatorias: 'bg-cancha-500 text-white',
  Torneos: 'bg-cancha-700 text-white',
  Institucional: 'bg-slate-500 text-white',
};
---

<a
  href={`/noticias/${noticia.slug}`}
  class:list={[
    'group block rounded-2xl bg-white shadow-sm border border-slate-200 overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all',
    destacada ? 'md:col-span-2' : '',
  ]}
>
  <div class:list={['p-6', destacada ? 'md:p-8' : '']}>
    <div class="flex items-center gap-3 mb-3">
      <span class:list={['text-xs font-semibold px-3 py-1 rounded-full', categoriaColor[categoria]]}>
        {categoria}
      </span>
      <time class="text-xs text-slate-500">{fechaFormateada}</time>
    </div>
    <h3 class:list={['font-display font-bold text-cancha-900 group-hover:text-cancha-600 transition-colors', destacada ? 'text-2xl md:text-3xl mb-3' : 'text-lg mb-2']}>
      {titulo}
    </h3>
    <p class:list={['text-slate-600', destacada ? 'text-base' : 'text-sm']}>{resumen}</p>
    <span class="inline-block mt-4 text-sm font-semibold text-cancha-600 group-hover:translate-x-1 transition-transform">
      Leer más →
    </span>
  </div>
</a>
