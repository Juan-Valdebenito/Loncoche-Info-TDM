---
import Layout from '../layouts/Layout.astro';

// Pendiente: agregar aquí los jugadores del taller cuando se confirmen los nombres.
const jugadores: { nombre: string; categoria: string; rol: string }[] = [];

const cuerpoTecnico = [
  { nombre: 'Sebastián Urrutia', rol: 'Entrenador ITTF' },
];

// Ranking de todos los jugadores del taller. Pendiente: reemplazar por los nombres reales.
const ranking = [
  { posicion: 1, nombre: 'Pendiente', categoria: '—', puntos: '—' },
  { posicion: 2, nombre: 'Pendiente', categoria: '—', puntos: '—' },
  { posicion: 3, nombre: 'Pendiente', categoria: '—', puntos: '—' },
];
---

<Layout title="Equipo" description="Conoce a los jugadores y cuerpo técnico de la Selección de Tenis de Mesa de Loncoche.">
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="font-display font-bold text-3xl text-cancha-900 mb-2">Nuestro Equipo</h1>
    <p class="text-slate-600 mb-10 max-w-2xl">
      Conoce a los deportistas y al cuerpo técnico que representan a la comuna de Loncoche en el tenis de mesa regional y nacional.
    </p>

    <h2 class="font-display font-semibold text-xl text-cancha-800 mb-4">Jugadores</h2>
    {jugadores.length === 0 ? (
      <p class="text-slate-500 text-sm mb-12">Próximamente publicaremos la nómina de jugadores.</p>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-12">
        {jugadores.map((j) => (
          <div class="rounded-2xl bg-white border border-slate-200 p-5 shadow-sm text-center">
            <div class="mx-auto h-16 w-16 rounded-full bg-cancha-100 text-cancha-700 flex items-center justify-center font-display font-bold text-xl mb-3">
              {j.nombre.split(' ').map((p) => p[0]).join('').slice(0, 2)}
            </div>
            <p class="font-semibold text-cancha-900">{j.nombre}</p>
            <p class="text-xs text-pelota-600 font-medium mt-1">{j.rol}</p>
            <p class="text-xs text-slate-500">{j.categoria}</p>
          </div>
        ))}
      </div>
    )}

    <h2 class="font-display font-semibold text-xl text-cancha-800 mb-4">Cuerpo Técnico</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-12">
      {cuerpoTecnico.map((c) => (
        <div class="rounded-2xl bg-white border border-slate-200 p-5 shadow-sm text-center">
          <div class="mx-auto h-16 w-16 rounded-full bg-pelota-100 text-pelota-600 flex items-center justify-center font-display font-bold text-xl mb-3">
            {c.nombre.split(' ').map((p) => p[0]).join('').slice(0, 2)}
          </div>
          <p class="font-semibold text-cancha-900">{c.nombre}</p>
          <p class="text-xs text-slate-500 mt-1">{c.rol}</p>
        </div>
      ))}
    </div>

    <h2 class="font-display font-semibold text-xl text-cancha-800 mb-4">Ranking del taller</h2>
    <p class="text-slate-600 mb-4 max-w-2xl text-sm">
      Listado con todos los integrantes del taller de tenis de mesa. Se actualizará con los nombres y categorías reales.
    </p>
    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm mb-4">
      <table class="w-full text-sm text-left">
        <thead class="bg-cancha-800 text-white">
          <tr>
            <th class="px-4 py-3 font-semibold">#</th>
            <th class="px-4 py-3 font-semibold">Nombre</th>
            <th class="px-4 py-3 font-semibold">Categoría</th>
            <th class="px-4 py-3 font-semibold">Puntos</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          {ranking.map((r) => (
            <tr class="odd:bg-white even:bg-slate-50">
              <td class="px-4 py-3 font-semibold text-cancha-700">{r.posicion}</td>
              <td class="px-4 py-3 text-cancha-900">{r.nombre}</td>
              <td class="px-4 py-3 text-slate-600">{r.categoria}</td>
              <td class="px-4 py-3 text-slate-600">{r.puntos}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>
